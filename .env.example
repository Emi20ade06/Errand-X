# ==============================================================================
# ErrandX Environment Configuration Schema (.env.example)
# Do NOT commit raw values to Git. Set these inside your Vercel/AI Studio UI.
# ==============================================================================

# 1. PRIVATE SECRETS (Server-side context / Backend proxy ONLY)
# Never expose these to the browser or prefix with VITE_
GEMINI_API_KEY="your_private_gemini_api_key_here"
API_ENCRYPTION_SECRET="your_secure_server_hash"

# 2. PUBLIC VARIABLES (Safe for frontend exposure via import.meta.env)
# Must be prefixed with VITE_ to be bundled by Vite
VITE_APP_URL="http://localhost:3000"
VITE_API_GATEWAY_URL="/api"
VITE_ENABLE_AI="true"

